# ── Invariant frontend — environment ────────────────────────────────────────
# Copy to `.env.local` for local dev. All vars are PUBLIC (NEXT_PUBLIC_*) because
# the prototype is frontend-only; a real deploy adds server-side secrets behind
# the API, never here.

# Data source for the lib/data seam.
#   fixtures → in-repo mock data (default; no backend needed)
#   api      → real backend (requires NEXT_PUBLIC_API_BASE_URL + the contract
#              in docs/BACKEND_CONTRACT.md to be satisfied)
NEXT_PUBLIC_DATA_SOURCE=fixtures

# Base URL of the backend that satisfies the lib/data contract. Only read when
# NEXT_PUBLIC_DATA_SOURCE=api. Example: https://api.invariant.example
# NEXT_PUBLIC_API_BASE_URL=
